  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 706e45c6045104c45b104dcab3e88869, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::IntroUI
  titleText: {fileID: 533369365}
  contentText: {fileID: 1018106883}
  titleContent: "M\u1ED9t ch\xFAt v\u1EC1 cu\u1ED9c \u0111\u1EDDi Nam "
  contentBody: "T\xF4i l\xE0 Hu\u1EF3nh \u0110\u1EE9c Nam, sinh n\u0103m 2004 t\u1EA1i
    H\xE0 N\u1ED9i. T\xF4i l\u1EDBn l\xEAn trong m\u1ED9t gia \u0111\xECnh lao \u0111\u1ED9ng
    b\xECnh th\u01B0\u1EDDng, s\u1ED1ng c\xF9ng b\u1ED1 m\u1EB9 trong m\u1ED9t ng\xF5
    nh\u1ECF, n\u01A1i h\xE0ng x\xF3m l\xE1ng gi\u1EC1ng \u0111\u1EC1u quen bi\u1EBFt
    nhau. Cu\u1ED9c s\u1ED1ng khi \u1EA5y ch\u1EB3ng m\u1EA5y kh\xE1 gi\u1EA3, nh\u01B0ng
    v\u1EDBi t\xF4i, \u0111\xF3 l\u1EA1i l\xE0 qu\xE3ng th\u1EDDi gian h\u1EA1nh
    ph\xFAc nh\u1EA5t.\r\n\r\nM\u1ED7i s\xE1ng th\u1EE9c d\u1EADy, t\xF4i \u0111\u1EC1u
    nghe ti\u1EBFng m\u1EB9 g\u1ECDi xu\u1ED1ng \u0103n s\xE1ng, c\xF2n b\u1ED1 th\xEC
    v\u1EEBa m\u1EDF c\u1EEDa ti\u1EC7m s\u1EEDa xe v\u1EEBa \u0111\u1EE9ng tr\xF2
    chuy\u1EC7n v\u1EDBi m\u1EA5y b\xE1c h\xE0ng x\xF3m \u0111\u1EA7u ng\xF5.\r\n\r\nM\u1ECDi
    th\u1EE9 thay \u0111\u1ED5i khi t\xF4i c\xF2n nh\u1ECF.\r\n\r\nM\u1EB9 t\xF4i
    qua \u0111\u1EDDi trong m\u1ED9t v\u1EE5 tai n\u1EA1n giao th\xF4ng. M\u1ECDi
    ng\u01B0\u1EDDi \u0111\u1EC1u n\xF3i \u0111\xF3 ch\u1EC9 l\xE0 m\u1ED9t tai n\u1EA1n
    \u0111\xE1ng ti\u1EBFc, nh\u01B0ng s\u1EF1 ra \u0111i c\u1EE7a m\u1EB9 \u0111\xE3
    \u0111\u1EC3 l\u1EA1i trong t\xF4i m\u1ED9t kho\u1EA3ng tr\u1ED1ng kh\xF4ng g\xEC
    c\xF3 th\u1EC3 b\xF9 \u0111\u1EAFp \u0111\u01B0\u1EE3c.\r\n\r\nT\u1EEB ng\xE0y
    \u1EA5y, t\xF4i s\u1ED1ng c\xF9ng b\u1ED1. B\u1ED1 t\xF4i, ng\u01B0\u1EDDi m\xE0
    c\u1EA3 khu ph\u1ED1 v\u1EABn quen g\u1ECDi l\xE0 ch\xFA T\u01B0, m\u1ED9t m\xECnh
    g\u1ED3ng g\xE1nh ti\u1EC7m s\u1EEDa xe nh\u1ECF \u0111\u1EC3 nu\xF4i t\xF4i
    kh\xF4n l\u1EDBn.\r\n\r\nH\u1ED3i c\xF2n \u0111i h\u1ECDc, t\xF4i t\u1EEBng theo
    h\u1ECDc Vovinam \u1EDF m\u1ED9t v\xF5 \u0111\u01B0\u1EDDng g\u1EA7n nh\xE0.
    T\xF4i kh\xF4ng ph\u1EA3i h\u1ECDc vi\xEAn xu\u1EA5t s\u1EAFc nh\u1EA5t, c\u0169ng
    ch\u1EB3ng c\xF3 n\u0103ng khi\u1EBFu g\xEC \u0111\u1EB7c bi\u1EC7t. Nh\u01B0ng
    t\xF4i th\xEDch c\u1EA3m gi\xE1c \u0111\u01B0\u1EE3c r\xE8n luy\u1EC7n m\u1ED7i
    ng\xE0y, th\xEDch tinh th\u1EA7n v\xF5 \u0111\u1EA1o v\xE0 nh\u1EEFng \u0111i\u1EC1u
    th\u1EA7y d\u1EA1y v\u1EC1 c\xE1ch b\u1EA3o v\u1EC7 b\u1EA3n th\xE2n c\u0169ng
    nh\u01B0 b\u1EA3o v\u1EC7 ng\u01B0\u1EDDi kh\xE1c.\r\n\r\nSau khi m\u1EB9 m\u1EA5t,
    t\xF4i d\u1EA7n b\u1ECF v\xF5 \u0111\u1EC3 t\u1EADp trung ph\u1EE5 gi\xFAp b\u1ED1
    ki\u1EBFm s\u1ED1ng.\r\n\r\nNh\u1EEFng n\u0103m th\xE1ng sau \u0111\xF3 tr\xF4i
    qua kh\xE1 b\xECnh l\u1EB7ng. Ban ng\xE0y t\xF4i l\xE0m vi\u1EC7c \u1EDF ti\u1EC7m
    s\u1EEDa xe, t\u1ED1i v\u1EC1 \u0103n c\u01A1m c\xF9ng b\u1ED1. T\xF4i v\u1EABn
    lu\xF4n ngh\u0129 cu\u1ED9c s\u1ED1ng c\u1EE7a hai b\u1ED1 con s\u1EBD m\xE3i
    nh\u01B0 v\u1EADy.\r\n\r\nCho \u0111\u1EBFn ng\xE0y x\u1EA3y ra s\u1EF1 vi\u1EC7c
    \u1EA5y \u2013 ng\xE0y \u0111\xE3 thay \u0111\u1ED5i ho\xE0n to\xE0n cu\u1ED9c
    \u0111\u1EDDi t\xF4i.\r\n\n"
  titleStartDelay: 0.1
  contentStartDelay: 0
  sceneDuration: 30
  nextSceneName: 
