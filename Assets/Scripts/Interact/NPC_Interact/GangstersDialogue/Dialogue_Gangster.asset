  m_Script: {fileID: 11500000, guid: e048829dd91dc47498cde6f504b11987, type: 3}
  m_Name: Dialogue_Gangster
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: Nam
    text: "Anh l\xE0 ai t\u1EEB \u0111\xE2u b\u01B0\u1EDBc \u0111\u1EBFn n\u01A1i
      \u0111\xE2y ng\u1ECDt ng\xE0o trong s\u01B0\u01A1ng"
  - speakerName: 'Nam '
    text: "Kh\xF4ng l\u1EBD l\xE0 Stalker dang mu\u1ED1n h\xE3m hi\u1EBFp t\xF4i"
  - speakerName: Long
    text: "Hi\u1EBFp cmm  "
  - speakerName: Long
    text: "Xin t\u1EF1 gi\u1EDBi thi\u1EC7u , tao l\xE0 Long \u0111\u1EB9p trai \u0111\xE0n
      em c\u1EE7a t\xE0i ch\xF3 \u0111i\xEAn"
  - speakerName: Nam
    text: "t\xE0i ch\xF3 \u0111i\xEAn \xE0?"
  - speakerName: Long
    text: "m\xE0y th\u1EA5y t\u1EA1i sao tao l\u1EA1i th\xEDch \u0103n m\xEC g\xF3i?"
  - speakerName: Nam
    text: "L\xE0 t\u1EA1i z\xEC, m\xE0y kh\xF4ng th\xEDch \u0103n m\xEC ly "
  - speakerName: Long
    text: "\u0111\u1EADu ph\u1ED9ng \u1EBFu ph\u1EA3i, tao h\u1EBFt ti\u1EC1n r\u1ED3i 
      \u0111\u01B0a ti\u1EC1n m\xE0y \u0111\xE2y cho tttt"
  - speakerName: Nam
    text: "C\xF3 c\xE1i cc nha\nC\xF3 l\xE0m th\xEC m\u1EDBi c\xF3 \u0103n 'Hu\u1EA5n
      Rose\" said"
  - speakerName: Long
    text: "M\xE0y c\u1EF1 ?"
  - speakerName: 'Nam '
    text: "Sao l\u1EA1i kh\xF4ng"
  - speakerName: Nam
    text: "Cho m\xE0y bi\u1EBFt \u0110\u1EDDi n\xE0y tao ch\u1EC9 nghe m\u1ED7i l\u1EDDi
      ba tao th\xF4i\nM\xE0y l\xE0 th\xE1 g\xEC tao ph\u1EA3i nghe"
  - speakerName: Long
    text: "V\xEC tao c\xF3 m\u1EB9 c\xF2n m\xE0y th\xEC kh\xF4ng "
  - speakerName: Long
    text: "Ph\xE2n th\xE2n chi thu\u1EADt"
  - speakerName: Long
    text: Bu shin no jut su!
  - speakerName: Nam
    text: :-(((
