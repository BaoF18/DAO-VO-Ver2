  m_Script: {fileID: 11500000, guid: e048829dd91dc47498cde6f504b11987, type: 3}
  m_Name: AnhTaiXe
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: "Ch\xFA T\u01B0"
    text: "Nam !!\nS\u1EEDa gi\xFAp ch\xFA c\xE1i xe v\u1EDBi "
  - speakerName: Nam
    text: "d\u1EA1.\nXe m\xECnh b\u1ECB g\xEC v\u1EADy \u1EA1"
  - speakerName: "Ch\xFA T\u01B0"
    text: "Ch\xFA c\u0169ng kh\xF4ng bi\u1EBFt n\u1EEFa\nC\u1EE9 \u0111\u1EC1 m\xE1y
      l\xE0 xe n\xF3 ch\u1EA1y ch\xE1u coi gi\xFAp ch\xFA xem"
  - speakerName: Nam
    text: "....\n\u0110\u1EC3 ch\xE1u xem th\u1EED , ch\xFA v\xE0o nh\xE0 cho m\xE1t"
  - speakerName: "Ch\xFA T\u01B0"
    text: "K\xEA"
