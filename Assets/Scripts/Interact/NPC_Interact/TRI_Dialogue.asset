  m_Script: {fileID: 11500000, guid: e048829dd91dc47498cde6f504b11987, type: 3}
  m_Name: TRI_Dialogue
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: "Tr\xED"
    text: "Nam! M\xE0y nghe chuy\u1EC7n h\xF4m qua ch\u01B0a?\r\n\u0110\xE1m ng\u01B0\u1EDDi
      x\u0103m tr\u1ED5 l\u1EA1i t\u1EDBi khu m\xECnh."
  - speakerName: Nam
    text: "Tao bi\u1EBFt\u2026 t\u1EE5i n\xF3 t\u1EDBi ti\u1EC7m nh\xE0 tao."
  - speakerName: "Tr\xED"
    text: "D\u1EA1o n\xE0y t\u1EE5i n\xF3 l\u1ED9ng h\xE0nh l\u1EAFm.\r\nM\u1EA5y
      ti\u1EC7m trong h\u1EBBm b\u1ECB \xE9p \u0111\xF3ng ti\u1EC1n \u201Cb\u1EA3o
      k\xEA\u201D"
  - speakerName: "Tr\xED "
    text: "H\xECnh nh\u01B0 t\u1EE5i n\xF3 l\xE0m cho m\u1ED9t \xF4ng l\u1EDBn n\xE0o
      \u0111\xF3."
