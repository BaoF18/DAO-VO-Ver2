  m_Script: {fileID: 11500000, guid: e048829dd91dc47498cde6f504b11987, type: 3}
  m_Name: Ngoc
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: "Ng\u1ECDc"
    text: "Anh Nam, em nghe m\u1EA5y anh kia n\xF3i chuy\u1EC7n."
  - speakerName: Nam
    text: "Chuy\u1EC7n g\xEC?"
  - speakerName: "Ng\u1ECDc"
    text: "H\u1ECD n\xF3i m\u1EA5y v\u1EE5 trong khu n\xE0y kh\xF4ng ph\u1EA3i t\u1EF1
      nhi\xEAn \u0111\xE2u.\r\n\r\nH\xECnh nh\u01B0 c\xF3 m\u1EA5y c\xF4ng ty l\u1EDBn
      \u0111\u1EE9ng sau."
  - speakerName: Nam
    text: "C\xF4ng ty?"
  - speakerName: "Ng\u1ECDc"
    text: "Em nghe th\u1EA5y c\xE1i t\xEAn\u2026\r\nKhang."
