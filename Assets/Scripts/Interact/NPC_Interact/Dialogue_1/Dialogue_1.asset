  m_Name: Dialogue_1
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: "B\u1ED1 Nam"
    text: "T\u1EEB ng\xE0y m\u1EB9 m\u1EA5t, nh\xE0 m\xECnh c\u0169ng \xEDt \u0111i
      mi\u1EBFng \u0103n nh\u01B0ng v\u1EABn ph\u1EA3i c\u1ED1 g\u1EAFng l\xE0m "
  - speakerName: "B\u1ED1 Nam"
    text: "Kh\xF4ng c\u1ED1 l\xE0m th\xEC kh\xF4ng c\xF3 c\xE1i b\u1ECF m\u1ED3m"
  - speakerName: Nam
    text: "B\u1ED1 n\xF3i ch\xED ph\u1EA3i\r\n\r\n"
  - speakerName: "B\u1ED1 Nam"
    text: "Th\xF4i ra s\u1EEDa gi\xFAp b\u1ED1 c\xE1i xe \r\n\r\n"
  - speakerName: Nam
    text: "V\xE2ng ... "
