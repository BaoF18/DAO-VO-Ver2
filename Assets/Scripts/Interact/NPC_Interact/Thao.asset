  m_Script: {fileID: 11500000, guid: e048829dd91dc47498cde6f504b11987, type: 3}
  m_Name: Thao
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: "Th\u1EA3o"
    text: "Nam \xE0, d\u1EA1o n\xE0y con coi ch\u1EEBng cha con nh\xE9.\r\nM\u1EA5y
      ng\u01B0\u1EDDi l\u1EA1 c\u1EE9 \u0111i qua \u0111i l\u1EA1i trong h\u1EBBm."
  - speakerName: Nam
    text: "Con bi\u1EBFt\u2026 con s\u1EBD \u0111\u1EC3 \xFD."
  - speakerName: "Th\u1EA3o"
    text: "M\u1EB9 con ng\xE0y x\u01B0a c\u0169ng v\u1EADy\u2026\r\nL\xFAc n\xE0o
      c\u0169ng lo cho m\u1ECDi ng\u01B0\u1EDDi trong x\xF3m."
  - speakerName: "Th\u1EA3o"
    text: "(ng\u1EADp ng\u1EEBng)\r\r\nC\xF4 v\u1EABn th\u1EA5y l\u1EA1 v\u1EC1 v\u1EE5
      tai n\u1EA1n \u0111\xF3\u2026\r\nH\xF4m \u0111\xF3 c\xF4 nh\u1EDB l\xE0 c\xF3
      m\u1ED9t chi\u1EBFc xe ch\u1EA1y r\u1EA5t nhanh."
  - speakerName: Nam
    text: "\xDD c\xF4 l\xE0\u2026 kh\xF4ng ph\u1EA3i tai n\u1EA1n b\xECnh th\u01B0\u1EDDng?"
  - speakerName: "Th\u1EA3o"
    text: "C\xF4 c\u0169ng kh\xF4ng ch\u1EAFc\u2026 nh\u01B0ng c\u1EA3m gi\xE1c kh\xF4ng
      \u0111\xFAng."
