  lines:
  - speakerName: "Ch\xFA Grab"
    text: "Con xem giu\u0301p chu\u0301 ca\u0301i ba\u0301nh "
  - speakerName: Nam
    text: "Da\u0323, con la\u0300m li\xEA\u0300n\r\n\r\n"
  - speakerName: Nam
    text: "\"Nh\xECn\" \"Quan s\xE1t\" \"Ph\xE1t hi\u1EC7n\"\n "
