  lines:
  - speakerName: Nam
    text: "Xong r\u1ED3i nha ch\xFA"
  - speakerName: "Ch\xFA S\xE1u Grab"
    text: "Ch\xFA c\u1EA3m \u01A1n con, h\u1EBFt bao nhi\xEAu v\u1EADy con?"
