  m_Name: Dialogue_2 5
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: Nam
    text: "Em xong r\u1ED3i anh "
  - speakerName: "Anh h\xE0ng x\xF3m"
    text: "K\xEA , v\u1EADy xe anh b\u1ECB g\xEC v\u1EADy\r\n"
  - speakerName: Nam
    text: "Xe anh b\u1ECB h\u1ECFng bugi r\xF4i"
  - speakerName: "Anh h\xE0ng x\xF3m"
    text: "K\xEA th\u1EBF bao nhi\xEAu th\xEC ghi v\xE0o s\u1ED5 cho anh nha  "
  - speakerName: Nam
    text: "Ok anhng\u01B0\u1EDDi nh\xE0 c\u1EA3 m\xE0"
  - speakerName: "Anh h\xE0ng x\xF3m"
    text: "hahahahha ... anh ch\xE0o ku em nh\xE1\n"
  - speakerName: Nam
    text: "V\u1EA7ng Ku anh \u0111i c\u1EA9n th\u1EADn"
